# ─────────────────────────────────────────────────────────────────────────────
# boostsmall — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical app URL — drives OAuth callbacks, OG image URLs, email links.
# Localhost in dev. Vercel auto-supplies VERCEL_URL on deploys, but set this
# to https://boostsmall.com explicitly in your Vercel production env.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Postgres on Neon — Settings → Connection details → "Pooled connection"
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=""

# Auth.js — generate with: `openssl rand -base64 32`
AUTH_SECRET=""

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs to register:
#   http://localhost:3000/api/auth/callback/google
#   https://boostsmall.com/api/auth/callback/google
# Vercel preview deploys (*.vercel.app) won't work with Google sign-in.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend — for magic-link sign-in emails AND notification emails.
# Domain (boostsmall.com) must be verified with SPF/DKIM/DMARC records on Cloudflare.
# See README → "Email setup" for the exact records.
RESEND_API_KEY=""
RESEND_FROM_AUTH="noreply@boostsmall.com"
RESEND_FROM_NOTIFICATIONS="notifications@boostsmall.com"
RESEND_REPLY_TO="hello@boostsmall.com"

# First sign-in with this email is auto-promoted to ADMIN.
# Set this to your personal sign-in email.
ADMIN_EMAIL="leo@odysseysolutions.co"

# Mapbox — https://account.mapbox.com/access-tokens
# PUBLIC token is safe to expose (used in browser maps).
# SECRET token is server-side only (geocoding API).
NEXT_PUBLIC_MAPBOX_TOKEN=""
MAPBOX_SECRET_TOKEN=""

# UploadThing — https://uploadthing.com/dashboard (created per-app)
UPLOADTHING_TOKEN=""

# Optional: Upstash Redis for production rate limiting.
# In-memory fallback is used when these are unset.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
